{
  "name": "Gemini Generator",
  "description": "Auto Google Gemini™ for your prompts at scale. Batch generate and auto-download responses and images on Gemini.Google.com.",
  "version": "1.0",
  "version_name": "1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Gemini Generator"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-B5Vf3eNf.js"
      ],
      "all_frames": false,
      "matches": [
        "*://gemini.google.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "src/ui/side-panel/index.html"
  },
  "offline_enabled": true,
  "host_permissions": [
    "*://gemini.google.com/*"
  ],
  "permissions": [
    "storage",
    "tabs",
    "background",
    "sidePanel",
    "activeTab",
    "downloads",
    "debugger"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://gemini.google.com/*"
      ],
      "resources": [
        "assets/catchUploadFile.ts-CDtmzXS_.js",
        "assets/index.ts-B5Vf3eNf.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "src/assets/logo.png",
    "24": "src/assets/logo.png",
    "32": "src/assets/logo.png",
    "128": "src/assets/logo.png"
  }
}
